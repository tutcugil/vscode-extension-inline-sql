{
  "scopeName": "inline-sql.injection.typescript",
  "injectionSelector": "L:string.template.ts, L:string.quoted.double.ts, L:string.quoted.single.ts",
  "patterns": [
    { "include": "#sql-keywords" },
    { "include": "#sql-dml" },
    { "include": "#sql-types" },
    { "include": "#sql-functions" },
    { "include": "#sql-operators" },
    { "include": "#sql-star" },
    { "include": "#sql-numeric" }
  ],
  "repository": {
    "sql-dml": {
      "match": "(?i)\\b(SELECT|INSERT\\s+INTO|UPDATE|DELETE|CREATE|ALTER|DROP|TRUNCATE|MERGE|EXEC|EXECUTE|CALL|GRANT|REVOKE|WITH)\\b",
      "name": "keyword.other.DML.sql"
    },
    "sql-keywords": {
      "match": "(?i)\\b(FROM|WHERE|JOIN|INNER|LEFT|RIGHT|OUTER|CROSS|FULL|ON|AND|OR|NOT|IN|EXISTS|BETWEEN|LIKE|IS|NULL|AS|GROUP\\s+BY|ORDER\\s+BY|HAVING|LIMIT|OFFSET|UNION|ALL|INTERSECT|EXCEPT|DISTINCT|INTO|VALUES|SET|RETURNING|ASC|DESC|CASE|WHEN|THEN|ELSE|END|TOP|FETCH|NEXT|ROWS|ONLY|TABLE|INDEX|VIEW|PROCEDURE|FUNCTION|TRIGGER|PRIMARY\\s+KEY|FOREIGN\\s+KEY|REFERENCES|CONSTRAINT|DEFAULT|CHECK|UNIQUE|CASCADE|IF\\s+EXISTS|IF\\s+NOT\\s+EXISTS|BEGIN|COMMIT|ROLLBACK|DECLARE|GO|USE|DATABASE|SCHEMA|COLUMN|ADD|RENAME|OVER|PARTITION\\s+BY|WINDOW|RECURSIVE|LATERAL|NATURAL|USING|REPLACE|IGNORE|DELAYED|LOW_PRIORITY|HIGH_PRIORITY|STRAIGHT_JOIN|FORCE|EXPLAIN|ANALYZE|RETURNING|CONFLICT|NOTHING|EXCLUDED)\\b",
      "name": "keyword.other.sql"
    },
    "sql-types": {
      "match": "(?i)\\b(VARCHAR|CHAR|NVARCHAR|NCHAR|TEXT|NTEXT|INT|INTEGER|BIGINT|SMALLINT|TINYINT|FLOAT|DOUBLE|DECIMAL|NUMERIC|REAL|MONEY|SMALLMONEY|BOOLEAN|BOOL|BIT|DATE|TIME|TIMESTAMP|DATETIME|DATETIME2|SMALLDATETIME|DATETIMEOFFSET|BLOB|CLOB|BINARY|VARBINARY|IMAGE|XML|JSON|JSONB|UUID|UNIQUEIDENTIFIER|SERIAL|BIGSERIAL|SMALLSERIAL|ARRAY|BYTEA|INET|CIDR|MACADDR|POINT|LINE|POLYGON|CIRCLE|INTERVAL|TSQUERY|TSVECTOR|REGCLASS|RECORD|VOID|ENUM|CURSOR|TABLE|ROWVERSION|SQL_VARIANT|GEOGRAPHY|GEOMETRY|HIERARCHYID)\\b",
      "name": "storage.type.sql"
    },
    "sql-functions": {
      "match": "(?i)\\b(COUNT|SUM|AVG|MIN|MAX|COALESCE|NULLIF|CAST|CONVERT|ISNULL|IFNULL|NVL|NVL2|CONCAT|SUBSTRING|SUBSTR|TRIM|LTRIM|RTRIM|UPPER|LOWER|LENGTH|LEN|CHAR_LENGTH|CHARACTER_LENGTH|REPLACE|REVERSE|LEFT|RIGHT|LPAD|RPAD|POSITION|LOCATE|INSTR|CHARINDEX|PATINDEX|STUFF|STRING_AGG|GROUP_CONCAT|LISTAGG|NOW|CURRENT_TIMESTAMP|CURRENT_DATE|CURRENT_TIME|GETDATE|GETUTCDATE|SYSDATETIME|DATEADD|DATEDIFF|DATENAME|DATEPART|YEAR|MONTH|DAY|HOUR|MINUTE|SECOND|EXTRACT|DATE_TRUNC|DATE_PART|TO_DATE|TO_CHAR|TO_NUMBER|FORMAT|ROW_NUMBER|RANK|DENSE_RANK|NTILE|LAG|LEAD|FIRST_VALUE|LAST_VALUE|NTH_VALUE|PERCENT_RANK|CUME_DIST|ABS|CEILING|CEIL|FLOOR|ROUND|SIGN|POWER|SQRT|MOD|LOG|LOG10|EXP|PI|RAND|RANDOM|NEWID|GREATEST|LEAST|IIF|CHOOSE|DECODE|CASE)\\b(?=\\s*\\()",
      "name": "support.function.sql"
    },
    "sql-operators": {
      "match": "(?i)\\b(LIKE|ILIKE|SIMILAR\\s+TO|IS\\s+NULL|IS\\s+NOT\\s+NULL|IS\\s+DISTINCT\\s+FROM|NOT\\s+IN|NOT\\s+EXISTS|NOT\\s+BETWEEN|NOT\\s+LIKE|ANY|SOME|ALL)\\b",
      "name": "keyword.operator.sql"
    },
    "sql-star": {
      "match": "(?<=SELECT\\s|SELECT\\s\\s|,\\s)\\*",
      "name": "keyword.operator.star.sql"
    },
    "sql-numeric": {
      "match": "\\b\\d+(\\.\\d+)?\\b",
      "name": "constant.numeric.sql"
    }
  }
}
